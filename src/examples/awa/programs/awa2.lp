% ----------------------------
% Locomotion / environment
% ----------------------------
aquatic      :- swims.
aquatic      :- flippers.

airborne     :- flys.

burrower     :- tunnels.
arboreal     :- tree.

% If you want:
% terrestrial :- not aquatic.   % (ONLY if you enforce closed-world for swims/flippers)

% ----------------------------
% Dentition / diet
% ----------------------------
carnivore    :- meat.
carnivore    :- meatteeth.

herbivore    :- vegetation, not carnivore.

omnivore     :- meat, vegetation.
piscivore    :- fish.

filter_feeder :- strainteeth.
filter_feeder :- skimmer.

% ----------------------------
% Morphology
% ----------------------------
ungulate     :- hooves.
horned       :- horns.

tusked       :- tusks.
long_limbed  :- longleg.
long_necked  :- longneck.

tailed       :- tail.

pawed        :- paws.
pawed        :- pads.

% ----------------------------
% Activity / behavior
% ----------------------------
social       :- group.
solitaryish  :- solitary.

predator     :- hunter.
predator     :- stalker.

forages      :- forager.
hibernator   :- hibernate.

nocturnalish :- nocturnal.

% ----------------------------
% Broad “type” hints that match your feature style
% (still just implications, not definitions)
% ----------------------------
rodent_like  :- buckteeth.
rodent_like  :- tunnels.

canine       :- smelly, paws, not claws.
feline       :- claws, meatteeth, not buckteeth.

marine_mammal :- aquatic, toughskin, not furry.


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ANIMAL DERIVATION RULES (use derived attrs + negation)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

antelope        :- ungulate, horned, herbivore, not domestic.

grizzly_bear    :- furry, claws, carnivore, hibernate, not white.

killer_whale    :- ocean_animal, carnivore, filter_feeder, not blue.

beaver          :- aquatic, rodent_like, not meatteeth, not fierce.

dalmatian       :- domestic, patterned, not stripes, canine.

persian_cat     :- domestic, feline, bulbous, not lean, not stripes.

horse           :- domestic, ungulate, longneck, not horns.

